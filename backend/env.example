# ============================================================
# CMS Backend — Environment Variables
#
# Copy this to .env and fill in your values.
# These override defaults.yaml settings.
# ============================================================

# ── App ───────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=info
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Supabase (REQUIRED) ──────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Claude AI (Optional — disables agent if missing) ─
CLAUDE_API_KEY=your-claude-api-key
# AI_AGENT_ENABLED=true
# AI_AGENT_MODEL=claude-sonnet-4-20250514

# ── Auth ──────────────────────────────────────────────
# QR_TOKEN_SECRET=your-strong-secret-here
# QR_BASE_URL=http://localhost:5173/wg

# ── Notifications (Optional) ─────────────────────────
# NOTIFICATIONS_ENABLED=false
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=+1234567890

# ── AWS (Optional — for S3 uploads) ──────────────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# S3_BUCKET=cms-uploads

# ── Redis (Optional — for workers/caching) ───────────
# REDIS_URL=redis://localhost:6379/0

# ── CORS (comma-separated) ───────────────────────────
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
